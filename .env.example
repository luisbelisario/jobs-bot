# Telegram — crie um bot com @BotFather e cole o token aqui
TELEGRAM_BOT_TOKEN=seu_token_aqui
# Seu chat ID (opcional — o bot registra automaticamente quem interage)
TELEGRAM_CHAT_ID=

# Intervalo entre buscas automáticas (em horas)
SEARCH_INTERVAL_HOURS=12

# Buscar apenas em dias úteis? (true/false)
WEEKDAYS_ONLY=true

# Score mínimo para considerar uma vaga relevante (0 a 1)
MIN_MATCH_SCORE=0.25

# Fontes de vagas habilitadas (separadas por vírgula)
# Disponíveis: remoteok, himalayas, lever, ifood
ENABLED_SOURCES=remoteok,himalayas,lever,ifood

# Token do GitHub (opcional — aumenta limite de 60 para 5000 req/h)
# GITHUB_TOKEN=seu_token_github